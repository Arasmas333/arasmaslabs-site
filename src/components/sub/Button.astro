---
const {
  href = "#",
  label = "Learn More",
} = Astro.props;
---

<a class="button" href={href}>
  {label}
</a>

<style>
  .button {
    display: inline-block;
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    border: 1px solid currentColor;
    transition: opacity 0.2s ease;
  }

  .button:hover {
    opacity: 0.7;
  }
</style>
