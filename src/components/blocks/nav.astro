---
---

<nav class="site-nav" aria-label="Main navigation">
  <a class="brand" href="/" aria-label="Arasmas Labs Home">
  <img
    src="/images/nav/branding/ArasmasLabsBanner.PNG"
    alt="Arasmas Labs"
  />
</a>

  <ul class="nav-links">
   <li>
  <a class="main-nav-link" href="/">
    <img src="/images/nav/main/Arasmas.PNG" alt="" />
    <span>Home</span>
  </a>
</li>

    <li>
  <a class="about-nav-link" href="/about">
    <img src="/images/nav/main/About.PNG" alt="" />
    <span>About</span>
  </a>
</li>

    <li class="projects-menu">
    <button
  id="projects-button"
  class="projects-button"
  type="button"
  aria-expanded="false"
  aria-controls="projects-dropdown"
>
  <img src="/images/nav/main/Projects.PNG" alt="" />
  <span>Projects</span>
</button>

      <ul
        id="projects-dropdown"
        class="projects-dropdown"
        hidden
      >

        <li>
  <a href="/projects/theseus">
    <img src="/images/nav/projects/Theseus.PNG" alt="" />
    <span>Project Theseus</span>
  </a>
</li>

<li>
  <a href="/projects/daedalus">
    <img src="/images/nav/projects/Daedalus.PNG" alt="" />
    <span>Project Daedalus</span>
  </a>
</li>

<li>
  <a href="/projects/hephaestus">
    <img src="/images/nav/projects/Hephaestus.PNG" alt="" />
    <span>Project Hephaestus</span>
  </a>
</li>
      </ul>
    </li>

    <li>
  <a class="blog-nav-link" href="/blog">
    <img src="/images/nav/main/Blog.PNG" alt="" />
    <span>Blog</span>
  </a>
</li>

    <li>
  <a class="contact-nav-link" href="/contact">
    <img src="/images/nav/main/Contact.PNG" alt="" />
    <span>Contact</span>
  </a>
</li>
  </ul>
</nav>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--page-padding);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .brand {
    text-decoration: none;
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a,
  .projects-button {
    color: var(--color-text-muted);
    font: inherit;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .nav-links a:hover,
  .nav-links a:focus,
  .projects-button:hover,
  .projects-button:focus {
    color: var(--color-accent);
  }

  .projects-menu {
    position: relative;
  }

  .projects-button {
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .projects-dropdown {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 0;
    z-index: 1000;

    min-width: 220px;
    margin: 0;
    padding: var(--space-1) 0;

    list-style: none;

    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
  }

  .projects-dropdown[hidden] {
    display: none;
  }

  .projects-dropdown a {
    display: block;
    padding: 0.65rem 1rem;
    white-space: nowrap;
  }

  .projects-dropdown a:hover,
  .projects-dropdown a:focus {
    background: var(--color-surface-raised);
  }

  .projects-dropdown a {
  display: flex;
  align-items: center;
  gap: 5px;
}

.projects-dropdown img {
  width: 58px;
  height: 58px;
  object-fit: contain;
  flex-shrink: 0;
  margin-right: -10px;
}

.main-nav-link {
  display: flex;
  align-items: center;
  gap: 0;
}

.main-nav-link img {
  width: 58px;
  height: 58px;
  object-fit: contain;
  flex-shrink: 0;
  margin-right: -10px;
}

.about-nav-link {
  display: flex;
  align-items: center;
  gap: 0;
}

.about-nav-link img {
  width: 25px;
  height: 25px;
  object-fit: contain;
  flex-shrink: 0;
}

.projects-button {
  display: flex;
  align-items: center;
  gap: 0;
}

.projects-button img {
  width: 25px;
  height: 25px;
  object-fit: contain;
  flex-shrink: 0;
}

.blog-nav-link {
  display: flex;
  align-items: center;
  gap: 0;
}

.blog-nav-link img {
  width: 58px;
  height: 58px;
  object-fit: contain;
  flex-shrink: 0;
  margin-left: -15px;
}

.contact-nav-link {
  display: flex;
  align-items: center;
  gap: 0;
}

.contact-nav-link img {
  width: 58px;
  height: 58px;
  object-fit: contain;
  flex-shrink: 0;
  margin-left: -15px;
}

.brand img {
  width: 150px;
  height: auto;
  display: block;
  object-fit: contain;
}
</style>

<script>
  const button = document.getElementById("projects-button");
  const dropdown = document.getElementById("projects-dropdown");

  if (button && dropdown) {
    button.addEventListener("click", () => {
      const isOpen = button.getAttribute("aria-expanded") === "true";

      button.setAttribute("aria-expanded", String(!isOpen));
      dropdown.toggleAttribute("hidden", isOpen);
    });
  }
</script>