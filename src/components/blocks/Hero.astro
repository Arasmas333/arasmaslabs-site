---
---

<section class="hero">
  <div class="hero-content">
    <p class="eyebrow">Arasmas Labs</p>

    <h1>Build. Experiment. Discover.</h1>

<img
  class="hero-image"
  src="/images/home/ArasmasLabsIcon.png"
  alt="Arasmas Labs"
/>



    <p class="hero-description">
      An independent laboratory for engineering, experimentation,
      and the development of unconventional ideas.
    </p>

    <div class="hero-actions">
      <a href="/projects">Explore Projects</a>
      <a href="/about">About Arasmas Labs</a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding: var(--space-7) var(--page-padding);
  }

  .hero-content {
    width: 100%;
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .hero-description {
    max-width: 650px;
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
    font-size: 1.15rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .hero-actions a {
    padding: 0.75rem 1.25rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .hero-actions a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .hero-image {
  display: block;
  width: 100%;
  max-width: 500px;
  height: auto;
  margin: 0 0 var(--space-4);
  object-fit: contain;
}
</style>