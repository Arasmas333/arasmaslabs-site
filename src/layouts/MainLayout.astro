---
import "../styles/global.css";

import Nav from "../components/blocks/nav.astro";

import Footer from "../components/blocks/Footer.astro";

const { title = "Arasmas Labs" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Arasmas Labs — Research, experimentation, and engineering." />
    <title>{title}</title>
  </head>

  <body>
    <Nav />
    <slot />
    <Footer />
  </body>
</html>